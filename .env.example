# Application
ENVIRONMENT=development
SECRET_KEY=change-me-to-a-secure-random-string

# Database
DATABASE_URL=postgresql+asyncpg://fitforge:fitforge@db:5432/fitforge
POSTGRES_USER=fitforge
POSTGRES_PASSWORD=fitforge
POSTGRES_DB=fitforge

# Redis
REDIS_URL=redis://redis:6379/0

# CORS (comma-separated origins — NOT JSON)
CORS_ORIGINS=http://localhost:3000,http://localhost

# JWT / Auth
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_ALGORITHM=HS256

# Email (Mailhog in Docker Compose)
EMAIL_BACKEND=smtp
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Fitness Tracker <noreply@fitness-tracker.local>
SMTP_USE_TLS=false
FRONTEND_URL=http://localhost
EMAIL_VERIFICATION_EXPIRE_HOURS=24
PASSWORD_RESET_EXPIRE_HOURS=1

# Celery
CELERY_TASK_ALWAYS_EAGER=false

# OpenAI (optional for future AI features)
OPENAI_API_KEY=

# Frontend
NEXT_PUBLIC_API_URL=http://localhost/api
